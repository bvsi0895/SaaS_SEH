{
  "name": "seh-monorepo",
  "version": "1.0.0",
  "description": "Sistema de Seguridad e Higiene - Monorepo completo",
  "private": true,
  "scripts": {
    "dev:backend": "pnpm --filter seh-backend dev",
    "dev:web": "pnpm --filter seh-web dev",
    "dev:mobile": "pnpm --filter seh-mobile start",
    "build:backend": "pnpm --filter seh-backend build",
    "build:web": "pnpm --filter seh-web build",
    "build:all": "pnpm -r build",
    "test": "pnpm --filter seh-backend test",
    "test:cov": "pnpm --filter seh-backend test:cov",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@playwright/test": "1.52.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "keywords": [
    "seguridad",
    "higiene",
    "inspecciones",
    "saas",
    "industrial"
  ],
  "author": "SEH Team",
  "license": "PROPRIETARY"
}
