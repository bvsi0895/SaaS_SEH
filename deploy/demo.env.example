# Copiar a .env fuera de Git y reemplazar cada valor sensible.
POSTGRES_USER=seh_demo
POSTGRES_PASSWORD=REEMPLAZAR_CON_SECRETO_UNICO
POSTGRES_DB=seh_demo
DOMAIN=demo.seh.example
HTTP_PORT=80
HTTPS_PORT=443
NODE_ENV=production
JWT_SECRET=REEMPLAZAR_CON_SECRETO_LARGO
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=REEMPLAZAR_CON_OTRO_SECRETO_LARGO
JWT_REFRESH_EXPIRATION=30d
CORS_ORIGIN=https://demo.seh.example
ENABLE_SWAGGER=false
VITE_API_URL=/api
