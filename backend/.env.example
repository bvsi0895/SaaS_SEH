# Base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/seh_db?schema=public"

# JWT
JWT_SECRET="tu-secreto-super-seguro-cambialo-en-produccion"
JWT_EXPIRATION="7d"
JWT_REFRESH_SECRET="tu-refresh-secret-super-seguro"
JWT_REFRESH_EXPIRATION="30d"

# Servidor
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:5173,http://localhost:8081"

# Almacenamiento de archivos (fotos)
# Opciones: local | s3
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# Si usas S3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=seh-files

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logs
LOG_LEVEL=debug
