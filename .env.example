# ===========================================
# SEH Docker Compose - Variables de Entorno
# ===========================================

# PostgreSQL
POSTGRES_USER=seh_user
POSTGRES_PASSWORD=seh_password_cambiar_en_produccion
POSTGRES_DB=seh_db

# Backend
NODE_ENV=production
JWT_SECRET=tu-secreto-jwt-muy-seguro-cambiar-en-produccion
JWT_EXPIRES_IN=7d

# Frontend
VITE_API_URL=http://localhost:3000/api

# ===========================================
# Instrucciones:
# 1. Copiar este archivo a .env
# 2. Cambiar los valores por defecto
# 3. Ejecutar: docker-compose up -d
# ===========================================
