# ===========================================
# SEH Docker Compose - Variables de Entorno
# ===========================================

# PostgreSQL
POSTGRES_USER=seh_user
POSTGRES_PASSWORD=seh_password_cambiar_en_produccion
POSTGRES_DB=seh_db
DOMAIN=demo.example.com
HTTP_PORT=80
HTTPS_PORT=443

# Backend
NODE_ENV=production
JWT_SECRET=tu-secreto-jwt-muy-seguro-cambiar-en-produccion
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=generar-fuera-del-repositorio
JWT_REFRESH_EXPIRATION=30d
CORS_ORIGIN=https://demo.example.com
ENABLE_SWAGGER=false

# Frontend
VITE_API_URL=/api

# ===========================================
# Instrucciones:
# 1. Copiar este archivo a .env
# 2. Cambiar los valores por defecto
# 3. Validar: docker compose --env-file .env config --quiet
# 4. Iniciar: docker compose --env-file .env up -d --build
# ===========================================
# SaaS commercial control plane
SAAS_TRIAL_DAYS=15

